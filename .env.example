POSTGRES_DB=gamingplatform
POSTGRES_USER=gamingplatform
POSTGRES_PASSWORD=gamingplatform
POSTGRES_HOST_PORT=5433

SPRING_PROFILES_ACTIVE=postgres
APP_AI_PROVIDER=local

# Defaults for direct HTTP local development; direct HTTPS marks cookies Secure automatically.
APP_SESSION_COOKIE_SECURE=false
SERVER_FORWARD_HEADERS_STRATEGY=none
# HTTPS reverse proxy only: set true/native AFTER restricting the backend to a trusted
# proxy that overwrites forwarding headers with the public scheme, host, and port.
# Secure cookies alone do not configure the origin checked by browser write requests.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
